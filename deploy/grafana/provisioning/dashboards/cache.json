{
  "uid": "llmgw-cache",
  "title": "LLM Gateway: Cache",
  "tags": [
    "llm-gateway",
    "cache"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Hit rate (last 5 min)",
      "description": "Share of cache lookups that were hits, across all gateway nodes.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(llmgw_cache_lookups_total{result=\"hit\"}[5m])) / sum(increase(llmgw_cache_lookups_total[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Dollars saved (since start)",
      "description": "What the provider would have charged for the requests served from cache. Resets when a gateway restarts.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(llmgw_cost_saved_usd_total)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Dollars spent (since start)",
      "description": "What the gateway actually paid the provider (misses and bypasses).",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(llmgw_cost_usd_total)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Share of cost saved",
      "description": "Saved / (saved + spent).",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(llmgw_cost_saved_usd_total) / (sum(llmgw_cost_saved_usd_total) + sum(llmgw_cost_usd_total))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Hit rate",
      "description": "Hits / all lookups, 1 min rate.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(llmgw_cache_lookups_total{result=\"hit\"}[1m])) / sum(rate(llmgw_cache_lookups_total[1m]))",
          "legendFormat": "hit rate"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Dollars per minute: spent vs saved",
      "description": "Provider spend and cache savings per minute.",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(llmgw_cost_usd_total[1m]))",
          "legendFormat": "spent"
        },
        {
          "refId": "B",
          "expr": "sum(increase(llmgw_cost_saved_usd_total[1m]))",
          "legendFormat": "saved"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cache lookups per second",
      "description": "Lookups by result. An error is served as a miss.",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(llmgw_cache_lookups_total[1m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Cache lookup latency",
      "description": "Time to read from the cache (Redis round trip). A lookup slower than CACHE_REDIS_TIMEOUT_MS counts as an error.",
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(llmgw_cache_lookup_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(llmgw_cache_lookup_seconds_bucket[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(llmgw_cache_lookup_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Cache errors per second",
      "description": "Redis slow or down. Requests still succeed (the cache fails open).",
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (op) (rate(llmgw_cache_errors_total[1m]))",
          "legendFormat": "{{op}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Coalesced requests per second",
      "description": "Requests that waited for an identical in-flight request instead of calling the provider (CACHE_COALESCE), and waiters that gave up and called it themselves.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level) (rate(llmgw_cache_coalesced_total[1m]))",
          "legendFormat": "coalesced {{level}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(llmgw_cache_coalesce_fallback_total[1m]))",
          "legendFormat": "fallback"
        }
      ]
    }
  ]
}
